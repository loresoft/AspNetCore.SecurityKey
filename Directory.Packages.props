    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.3.1" />
    <PackageVersion Include="System.Diagnostics.DiagnosticSource" Version="11.0.0" />
    <PackageVersion Include="XUnit.Hosting" Version="5.0.0" />
